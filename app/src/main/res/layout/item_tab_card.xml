<?xml version="1.0" encoding="utf-8"?>
<!-- v1.3.40 — LOGO-TILE tab card (field report: "I don't like that all the
     tabs are showing the home icon in card view thumbnail, i like to clear
     cache so maybe the images will not stay, so replace the thumbnail
     with website icon entirely — proper icon, not just first letter").
     The card's main visual is now the site's real logo tile (aspect-true,
     brand-colored, favicon store + network fallback); the v1.3.39 page
     screenshot strip and its corner-favicon overlay are gone — snapshots
     die with the cache, the store does not. Same view IDs as item_tab_row
     so TabsAdapter.CardHolder binds both. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_margin="2dp"
    android:background="@drawable/bg_card">
    <FrameLayout android:layout_width="match_parent" android:layout_height="56dp">
        <!-- the site logo tile, centered; FIT_CENTER keeps the avatar's
             own aspect + framing (no stretched jpg look) -->
        <ImageView android:id="@+id/iv_thumb" android:layout_width="44dp"
            android:layout_height="44dp" android:layout_gravity="center"
            android:scaleType="fitCenter"/>
        <ImageButton android:id="@+id/btn_tab_close" android:layout_width="24dp" android:layout_height="24dp"
            android:layout_gravity="top|end" android:layout_margin="4dp"
            android:src="@drawable/ic_close" android:background="@drawable/bg_tab_btn"
            android:scaleType="centerInside" android:padding="4dp"/>
        <ImageButton android:id="@+id/btn_tab_menu" android:layout_width="24dp" android:layout_height="24dp"
            android:layout_gravity="top|start" android:layout_margin="4dp"
            android:src="@drawable/ic_more" android:background="@drawable/bg_tab_btn"
            android:scaleType="centerInside" android:padding="4dp"/>
        <!-- v1.3.40: the sleeping marker moved onto the tile frame -->
        <TextView android:id="@+id/tv_tab_sleep" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="bottom|end"
            android:layout_margin="4dp" android:textSize="10sp"
            android:textColor="?attr/colorTextDim" android:visibility="gone"/>
    </FrameLayout>
    <!-- v1.3.40 de-congestion: text zone padding 7/5/6 → 9/7/8 so the
         larger 13sp titles are not squeezed against the card edge -->
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingStart="9dp" android:paddingEnd="9dp"
        android:paddingTop="7dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/tv_tab_title" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorText"
            android:textSize="13sp" android:singleLine="true" android:ellipsize="end"
            android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/tv_tab_domain" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="?attr/colorTextDim"
            android:textSize="11sp" android:singleLine="true" android:ellipsize="end"
            android:layout_marginTop="1dp"/>
    </LinearLayout>
    <View android:id="@+id/v_strip" android:layout_width="match_parent" android:layout_height="3dp"/>
</LinearLayout>
