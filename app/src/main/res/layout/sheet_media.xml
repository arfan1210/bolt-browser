<?xml version="1.0" encoding="utf-8"?>
<!-- v1.3.34 — modern media sheet: grab handle, medium title, modern switch
     slot (BrowserActivity inserts Ui.ModernSwitch). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:background="@drawable/bg_sheet"
    android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="22dp">
    <View android:layout_width="36dp" android:layout_height="4dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="10dp"
        android:background="@drawable/bg_handle"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/media_controls" style="@style/BoltTitle"/>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/speed" android:textColor="?attr/colorText" android:textSize="16sp"/>
        <TextView android:id="@+id/tv_speed_val" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="?attr/colorAccent"
            android:textSize="16sp" android:fontFamily="sans-serif-medium" android:text="1.0x"/>
    </LinearLayout>
    <SeekBar android:id="@+id/sb_speed" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:max="39"/>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/volume_boost" android:textColor="?attr/colorText" android:textSize="16sp"/>
        <TextView android:id="@+id/tv_volume_val" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="?attr/colorAccent"
            android:textSize="16sp" android:fontFamily="sans-serif-medium" android:text="100%"/>
    </LinearLayout>
    <SeekBar android:id="@+id/sb_volume" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:max="300"/>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical">
        <FrameLayout android:id="@+id/fl_vocal_slot" android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="vertical" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/vocal_filter" android:textColor="?attr/colorText" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/vocal_filter_desc" android:textColor="?attr/colorTextDim" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>
    <!-- v1.3.79 — THE SILENCE SKIPPER: the video-control sheet's second
         independent toggle (Settings -> Media holds the persistent default;
         this is the in-session switch). -->
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical">
        <FrameLayout android:id="@+id/fl_skip_slot" android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="vertical" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/skip_silence" android:textColor="?attr/colorText" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/skip_silence_desc" android:textColor="?attr/colorTextDim" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>
    <!-- v1.3.87 — THE TUNING ROW: the four hysteresis knobs (speed 1x-8x,
         start-after, rewind-before-speech, ignore-short-silences) live one
         tap under the toggle that turns the feature on. -->
    <TextView android:id="@+id/tv_skip_tune" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="6dp"
        android:text="@string/skip_tune_row" android:textColor="?attr/colorTint"
        android:textSize="14sp" android:clickable="true" android:focusable="true"/>
</LinearLayout>
