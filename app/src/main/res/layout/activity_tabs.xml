<?xml version="1.0" encoding="utf-8"?>
<!-- v1.3.34 — the modern tabs switcher: 64dp header with round-ripple
     controls + 22sp medium title; a SEGMENTED normal/incognito control
     (bg_segment container; TabsActivity paints the active segment pill);
     modern bottom action bar — tonal "new group", quiet circle for
     incognito, and an elevated 56dp accent FAB for new tab. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorBg">
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="64dp" android:gravity="center_vertical"
        android:paddingStart="10dp" android:paddingEnd="10dp">
        <ImageButton android:id="@+id/btn_t_back" android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_close" android:background="@drawable/bg_item_round"
            android:contentDescription="@string/close" android:tooltipText="@string/close"/>
        <TextView android:id="@+id/tv_t_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:text="@string/tabs"
            style="@style/BoltTitle"/>
        <ImageButton android:id="@+id/btn_t_search" android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_search" android:background="@drawable/bg_item_round"
            android:contentDescription="@string/search" android:tooltipText="@string/search"/>
        <!-- v1.3.40 DE-CONGESTION + ICON DIFFERENTIATION (field tasks 6/14):
             the header's "select" and "close all" buttons are GONE — the row
             held SIX 44dp buttons and, worse, close-all used a bin icon
             identical to the trash bin (ic_delete === ic_trash paths), so
             "delete" and "trash" were indistinguishable. Both actions now
             live in the 3-dot menu as text rows (Chrome's own switcher
             pattern), leaving ONE bin on screen: trash = restore. -->
        <ImageButton android:id="@+id/btn_t_menu" android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_more" android:background="@drawable/bg_item_round"
            android:contentDescription="@string/more_options" android:tooltipText="@string/more_options"/>
        <!-- v1.3.39 — the tab trash bin (menu-3 #7): closed tabs rest here for 7 days -->
        <ImageButton android:id="@+id/btn_t_trash" android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_trash" android:background="@drawable/bg_item_round"
            android:contentDescription="Recently closed tabs" android:tooltipText="Recently closed tabs"/>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="2dp" android:paddingBottom="4dp">
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
            android:layout_height="40dp" android:background="@drawable/bg_segment"
            android:padding="4dp">
            <TextView android:id="@+id/chip_normal" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:text="@string/normal"
                android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
            <TextView android:id="@+id/chip_incognito" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:text="@string/incognito"
                android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/tv_drag_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="@string/drag_hint" android:textColor="?attr/colorTextDim"
        android:textSize="12sp" android:paddingBottom="2dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_tabs"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:padding="10dp" android:clipToPadding="false" android:overScrollMode="never"/>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="6dp" android:paddingBottom="16dp">
        <TextView android:id="@+id/btn_new_group" android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:gravity="center" android:text="@string/new_group"
            android:background="@drawable/bg_chip" android:textColor="?attr/colorText" android:textSize="15sp"
            android:fontFamily="sans-serif-medium"/>
        <Space android:layout_width="10dp" android:layout_height="1dp"/>
        <ImageButton android:id="@+id/btn_new_incognito" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_incognito" android:background="@drawable/bg_chip"
            android:contentDescription="@string/new_incognito_tab" android:tooltipText="@string/new_incognito_tab"/>
        <Space android:layout_width="10dp" android:layout_height="1dp"/>
        <ImageButton android:id="@+id/btn_new_tab" android:layout_width="56dp" android:layout_height="56dp"
            android:src="@drawable/ic_plus" android:background="@drawable/bg_fab"
            android:scaleType="centerInside"
            android:contentDescription="@string/new_tab" android:tooltipText="@string/new_tab"/>
    </LinearLayout>
</LinearLayout>
