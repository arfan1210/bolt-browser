<?xml version="1.0" encoding="utf-8"?>
<!-- v1.3.39 — GROUP AS A CARD (card view): field report "make the folder
     tab a card also with a folder logo in card view". Same IDs as
     item_group_row (GroupHolder binds both); the dot slot becomes the
     tinted FOLDER icon container, the mini-cards strip stays for
     expand-in-place. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_margin="2dp"
    android:background="@drawable/bg_card" android:padding="7dp">
    <LinearLayout android:id="@+id/ll_group_header" android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:background="@drawable/bg_item">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp">
            <ImageView android:id="@+id/v_group_dot" android:layout_width="20dp"
                android:layout_height="20dp" android:layout_gravity="center"
                android:src="@drawable/ic_folder" android:scaleType="centerInside"/>
        </FrameLayout>
        <TextView android:id="@+id/tv_group_name" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp" android:textColor="?attr/colorText"
            android:textSize="13sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/>
        <TextView android:id="@+id/tv_group_count" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="?attr/colorTextDim" android:textSize="12sp"/>
        <ImageView android:id="@+id/iv_group_chevron" android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/ic_chevron" android:scaleType="centerInside" android:padding="2dp"/>
        <ImageButton android:id="@+id/btn_group_menu" android:layout_width="28dp" android:layout_height="28dp"
            android:src="@drawable/ic_more" android:background="@drawable/bg_item"/>
    </LinearLayout>
    <HorizontalScrollView android:id="@+id/hv_group_cards" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:scrollbars="none">
        <LinearLayout android:id="@+id/ll_group_cards" android:orientation="horizontal"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </HorizontalScrollView>
    <!-- v1.4.16 — the grouped-active accent strip (same law as the tab
         card's v_strip): accent when tm.active is one of this folder's
         members, transparent otherwise (TabsAdapter binds it). -->
    <View android:id="@+id/v_group_strip" android:layout_width="match_parent"
        android:layout_height="3dp"/>
</LinearLayout>
