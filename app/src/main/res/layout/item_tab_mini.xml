<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="84dp" android:layout_height="wrap_content"
    android:layout_margin="2dp" android:background="@drawable/bg_card">
    <FrameLayout android:layout_width="match_parent" android:layout_height="46dp">
        <!-- v1.3.40: the group-strip mini shows the site's logo tile too
             (uniform with the cards; snapshots die with the cache) -->
        <ImageView android:id="@+id/iv_mini_thumb" android:layout_width="36dp"
            android:layout_height="36dp" android:layout_gravity="center"
            android:scaleType="fitCenter"/>
        <!-- v1.4.9: the mini's ⋯ — the visible door to the member menu
             (Edit tab / Remove from group / Move to group / Close tab);
             it replaces the old X, whose only action (close) is the menu's
             last row now -->
        <ImageButton android:id="@+id/btn_mini_menu" android:layout_width="22dp" android:layout_height="22dp"
            android:layout_gravity="top|end" android:layout_margin="3dp"
            android:src="@drawable/ic_more" android:background="@drawable/bg_tab_btn"
            android:scaleType="centerInside" android:padding="4dp"/>
    </FrameLayout>
    <TextView android:id="@+id/tv_mini_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="6dp" android:textColor="?attr/colorText"
        android:textSize="11sp" android:singleLine="true" android:ellipsize="end"/>
</LinearLayout>