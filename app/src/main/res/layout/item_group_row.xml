<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_margin="5dp"
    android:background="@drawable/bg_card" android:padding="8dp">
    <LinearLayout android:id="@+id/ll_group_header" android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:background="@drawable/bg_item">
        <View android:id="@+id/v_group_dot" android:layout_width="12dp" android:layout_height="12dp"/>
        <TextView android:id="@+id/tv_group_name" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp" android:textColor="?attr/colorText"
            android:textSize="15sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/>
        <TextView android:id="@+id/tv_group_count" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="?attr/colorTextDim" android:textSize="13sp"/>
        <ImageView android:id="@+id/iv_group_chevron" android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/ic_chevron" android:scaleType="centerInside" android:padding="3dp"/>
        <ImageButton android:id="@+id/btn_group_menu" android:layout_width="34dp" android:layout_height="34dp"
            android:src="@drawable/ic_more" android:background="@drawable/bg_item"/>
    </LinearLayout>
    <HorizontalScrollView android:id="@+id/hv_group_cards" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp" android:scrollbars="none">
        <LinearLayout android:id="@+id/ll_group_cards" android:orientation="horizontal"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </HorizontalScrollView>
    <!-- v1.4.16 — the grouped-active accent strip (same law as the tab
         card's v_strip): accent when tm.active is one of this folder's
         members, transparent otherwise (TabsAdapter binds it). -->
    <View android:id="@+id/v_group_strip" android:layout_width="match_parent"
        android:layout_height="3dp"/>
</LinearLayout>
