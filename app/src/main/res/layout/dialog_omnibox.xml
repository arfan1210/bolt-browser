<?xml version="1.0" encoding="utf-8"?>
<!-- v1.3.34 — modern omnibox sheet: grab handle, 24dp rounded top, taller
     52dp url field with 16sp type. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:background="@drawable/bg_sheet"
    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="14dp" android:paddingTop="8dp">
    <!-- v1.3.36: handle only when bottom-anchored (urlBarBottom); the
         top-anchored dropdown hides it — it hangs from the edge instead -->
    <View android:id="@+id/omni_handle" android:layout_width="36dp" android:layout_height="4dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="10dp"
        android:background="@drawable/bg_handle"/>
    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_urlbar" android:gravity="center_vertical">
        <!-- v1.4.12 — THE ENGINE CHIP: the old static search glyph is now a
             clickable chip (glyph + drop arrow) that opens the engine
             picker — Google / DuckDuckGo / Bing / Brave / Startpage — for
             the query currently in the field. -->
        <LinearLayout android:id="@+id/omni_engine"
            android:orientation="horizontal"
            android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center_vertical" android:paddingStart="10dp"
            android:paddingEnd="2dp" android:background="?attr/selectableItemBackground"
            android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/iv_omni_search"
                android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/search"/>
            <ImageView android:id="@+id/iv_omni_engine_arrow"
                android:layout_width="14dp" android:layout_height="14dp"
                android:layout_marginStart="1dp"
                android:src="@drawable/ic_drop_down"
                android:contentDescription="Choose search engine"/>
        </LinearLayout>
        <EditText android:id="@+id/et_omni"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:singleLine="true"
            android:imeOptions="actionGo" android:hint="@string/search_hint"
            android:textSize="17sp" android:background="@null"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:importantForAutofill="no"/>
        <!-- v1.4.12 — THE IMAGE-SEARCH DOOR: camera or gallery pick, the
             picture routes to the selected engine's visual search. -->
        <ImageButton android:id="@+id/btn_omni_cam"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_camera" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Image search"/>
        <ImageButton android:id="@+id/btn_omni_voice"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_mic" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voice search"/>
        <ImageButton android:id="@+id/btn_omni_paste"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_paste" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/paste"/>
        <ImageButton android:id="@+id/btn_omni_copy"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_copy" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/copy"/>
        <ImageButton android:id="@+id/btn_omni_clear"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_close" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clear"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_suggest" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:overScrollMode="never"/>
</LinearLayout>
