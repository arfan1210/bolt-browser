<!-- v1.3.81 — PIKA: the Pokémon-style launcher face (the field ask: themed
     bolt icons — "like pokemon (pikachu's tail)"). A chunky lightning bolt
     whose bottom third turns brown through a clip-path — the read is
     Pikachu's tail — on Pikachu yellow. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- the bolt body -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M64,20 L30,64 H48 L38,88 L80,42 H60 Z"/>
    <!-- the tail's brown base: only the part inside the bolt paints -->
    <group>
        <clip-path android:pathData="M64,20 L30,64 H48 L38,88 L80,42 H60 Z"/>
        <path android:fillColor="#FF8C5A2B"
            android:pathData="M18,66 H90 V100 H18 Z"/>
    </group>
</vector>
