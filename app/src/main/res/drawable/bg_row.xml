<?xml version="1.0" encoding="utf-8"?>
<!-- v1.3.34 — the modern list row: rounded-16 surface card with a hairline
     outline (reads on every skin: light cards get definition, dark cards a
     subtle edge, glass gets its rim) + a themed ripple. Rows sit as separate
     cards with gaps between (LibreTube/Google settings grouping). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33888888">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurface"/>
            <stroke android:width="1dp" android:color="?attr/colorOutline"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</ripple>
