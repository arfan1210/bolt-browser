<?xml version="1.0" encoding="utf-8"?>
<!-- v1.3.34 — small surface-based circle button for tab cards (close/menu):
     opaque surface + hairline outline reads on any thumbnail, any skin. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33888888">
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/colorSurface"/>
            <stroke android:width="1dp" android:color="?attr/colorOutline"/>
        </shape>
    </item>
</ripple>
