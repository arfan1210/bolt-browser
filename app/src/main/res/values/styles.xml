    <!-- v1.3.36 — the slide transitions every activity shares (set once on
         Theme.Bolt via android:windowAnimationStyle): open = new screen
         slides in from the right, the old one eases left and dims; close =
         the exact mirror, so back feels like pulling the screen back. -->
    <style name="BoltWindowAnimations" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/bolt_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/bolt_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/bolt_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/bolt_close_exit</item>
    </style>

