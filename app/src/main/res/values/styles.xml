<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- v1.3.33: every theme also sets the android:textColor* family —
         the v1.3.32 field report ("texts not visible in dark or light mode")
         was largely THIS: the themes extended Theme.AppCompat.NoActionBar
         (a DARK theme) without overriding text colors.

         v1.3.35: EVERY SKIN now has a LIGHT and a DARK variant (field report:
         "all of them don't have both a light and dark mode, and they don't
         seem much different"). Ten activity themes + ten dialog themes.
         Distinctness comes from palette + SIGNATURE accent (the XML default
         AND the "Auto" runtime accent) + per-skin corner radii (Fx.radius):
         Classic blue/16dp, Aura violet glass/20dp, Mono ink-on-paper/8dp,
         Origins warm/24dp, Pulse teal/18dp.

         v1.3.35 WHITE-ON-WHITE ROOT FIX: AlertDialog list items (every
         Builder.setItems/setSingleChoiceItems/setMultiChoiceItems "random
         popup menu") color their text with ?attr/textColorAlertDialogListItem,
         which the DARK AppCompat dialog base sets to WHITE — our dialog
         themes only overrode android:textColorPrimary, so light-mode menus
         rendered white text on the white panel. Every BoltDialog.* now sets
         textColorAlertDialogListItem (plus android:colorControl* for the
         radio/checkbox tint) explicitly per lightness. -->
    <style name="Theme.Bolt" parent="Theme.AppCompat.NoActionBar">
        <item name="alertDialogTheme">@style/BoltDialog.Light</item>
        <!-- v1.3.36 — the modern slide transitions (settings screens slide in
             from the right, back mirrors it) applied once here so all ten
             theme variants inherit them -->
        <item name="android:windowAnimationStyle">@style/BoltWindowAnimations</item>
        <item name="colorBg">@color/light_bg</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorSurface2">@color/light_surface2</item>
        <item name="colorText">@color/light_text</item>
        <item name="colorTextDim">@color/light_text_dim</item>
        <item name="colorOutline">@color/light_outline</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="colorAccentSoft">#1F3E8BFF</item>
        <item name="colorTint">#5A5A66</item>
        <item name="colorDanger">@color/danger</item>
        <item name="skinStyle">0</item>
        <item name="android:textColorPrimary">@color/light_text</item>
        <item name="android:textColorSecondary">@color/light_text_dim</item>
        <item name="android:textColorHint">@color/light_text_dim</item>
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorControlActivated">@color/accent_blue</item>
        <item name="android:windowBackground">?attr/colorBg</item>
        <item name="android:statusBarColor">?attr/colorBg</item>
        <item name="android:navigationBarColor">?attr/colorBg</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- v1.3.81 — isLightTheme is what WebView's algorithmic darkening
             (API 33+) reads to decide whether the app theme is dark. Without
             it the dark skins below only LOOKED dark (swapped colors) and
             setAlgorithmicDarkeningAllowed(true) was a permanent no-op —
             the "force dark site does nothing" field report. -->
        <item name="android:isLightTheme">true</item>
    </style>

