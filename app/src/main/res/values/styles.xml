    <!-- ============ v1.3.34/35 — modern dialogs ============ -->
    <!-- Every AlertDialog gets a rounded 24dp panel (bg_dialog resolves
         ?attr/colorSurface against the DIALOG's theme, so each skin+lightness
         needs its own dialog theme carrying the palette). Buttons: medium
         weight, sentence case, comfortable padding. v1.3.35: each variant now
         ALSO sets textColorAlertDialogListItem (the attr AlertDialog list
         items actually use — see the styles.xml header note: the AppCompat
         dialog base is DARK and left it white) and the android:colorControl*
         pair so radios/checkmarks tint with the accent.
         Per-skin corner radius: bg_dialog 24dp (classic/aura/pulse),
         bg_dialog_sharp 10dp (mono), bg_dialog_round 28dp (origins).
         NOTE: dialogs use the SKIN-SIGNATURE accent (XML can't see the
         runtime accent picker) — same accepted tradeoff as before. -->
    <style name="Widget.Bolt.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="BoltDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="buttonBarButtonStyle">@style/Widget.Bolt.DialogButton</item>
