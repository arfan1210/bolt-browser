    <!-- ============ v1.3.33 skins ============ -->

    <!-- AURA — translucent dark glass. Surfaces carry alpha so panels/dim
         layers read as smoked glass; hairline outlines (#29FFFFFF) are the
         glass rim. Window bg stays opaque (translucent activity windows are
         a mess across OEMs); the GLASS effect lives on overlay surfaces:
         the browser bars (which float over the page since v1.3.33),
         dialogs, sheets and menus. -->
    <color name="aura_bg">#0C0A1E</color>
    <color name="aura_surface">#E6161430</color>
    <color name="aura_surface2">#B3262447</color>
    <color name="aura_text">#F2EFFF</color>
    <!-- v1.3.45 (field: "in dark glass, make the icons WHITE instead of
         darkish"): the icon tint is now pure white and the dim lavender
         (used by menu/sheet icons + secondary text) was lifted a full step —
         v1.3.44's #E8E8F2/#A295D6 still read as grey-on-purple over the
         smoked glass. -->
    <color name="aura_text_dim">#C6B9F5</color>
    <color name="aura_outline">#33FFFFFF</color>
    <color name="aura_tint">#FFFFFF</color>
    <color name="aura_accent">#9A7BFF</color>
    <color name="aura_accent_soft">#339A7BFF</color>
    <!-- bar glass: what the toolbar/bottombar are painted with (over the page) -->
    <color name="aura_bar">#C60E0E1A</color>

    <!-- MONO — true-black flat minimal. High contrast, no decoration.
