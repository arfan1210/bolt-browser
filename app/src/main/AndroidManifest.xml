    <!-- v1.3.27 background survival: sideloaded APK (GitHub releases) — the
         Play-policy restrictions on requesting this exemption do not apply.
         Lets the media service ask the user directly for the battery
         optimization whitelist (the single strongest defense against
         OEM/lmkd killing backgrounded playback). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- v1.3.78 — APK "Open" after download must reach the package
         installer: Android 8+ refuses ACTION_VIEW install intents from
         apps without this grant ("apks downloaded don't open when I click
         open after downloading and have to open it from file manager to
         install"). Sideloaded-from-GitHub app; the Play-policy question
         does not apply. The user still confirms the per-app switch once
         (deep-linked from the downloads screen). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".BoltApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Bolt">

        <!-- v1.3.83 — THE ACTIVITY IS DEMOTED. It must NEVER carry the
             MAIN/LAUNCHER (or VIEW) filter again: v1.3.79/80's icon picker
             left an EXPLICIT DISABLE persisted on this exact component
             (com.bolt.browser.ui.BrowserActivity), that state SURVIVES every
             future update (component-enabled state is persistent device
             state, and MY_PACKAGE_REPLACED is NOT delivered to stopped /
             never-started apps — the v1.3.82 receiver could never fire on
             the stranded field device), so any manifest filter here is a
             filter on a component the field can never enable again. The
             launcher contract now lives on .ui.IconDefault below, a name
             that NEVER existed in any earlier APK — a brand-new component
             carries NO persisted state, so it ships enabled (as declared
             here) the moment v1.3.83 installs: the icon REAPPEARS at
             install time, zero code execution, even in the stopped state.
             Field-proven safe: v1.3.80 ran fine with this activity
             explicitly disabled while the Midnight alias fronted it — an
             enabled alias launches its target regardless of the target's
             own enabled state. -->
        <activity
            android:name=".ui.BrowserActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|density"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:exported="true" />

        <!-- v1.3.83 — THE DEFAULT FACE, IMMORTAL. THE RESURRECTION ALIAS:
             the launcher contract moved OFF the real activity (whose
             persisted DISABLE stranded the field device through v1.3.81
             AND v1.3.82) onto this NEW component name. Rules that must
             hold forever:
               - android:enabled="true" IN THE PACKAGED MANIFEST — this is
                 the one launcher face whose DEFAULT is on, so a fresh
                 install, and every stranded device get an icon with NO
                 code execution at all;
               - NEVER rename, remove, or disable-by-default this alias in
                 any future release — a new APK may flip its RUNTIME state,
                 but this declaration is the install-time guarantee;
               - if a future release must retire a THEMED alias, this
                 default (plus LauncherGuard) is the guaranteed fallback —
                 rotating THIS name is the absolute last resort (a rename
                 resurrects stranded devices the same way this release
                 does, but it costs every healthy user their home-screen
                 placement once). -->
        <activity-alias
            android:name=".ui.IconDefault"
            android:targetActivity=".ui.BrowserActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- v1.4.12 — THE SYSTEM SEARCH ENTRIES. Bolt was missing from
                 the text-selection floating toolbar and the "Web search"
                 surfaces because nothing declared the three system search
                 actions. Every launcher alias carries them (exactly one
                 face is enabled at a time, so the app answers regardless
                 of which icon is active):
                   - WEB_SEARCH: the system search dialog / quick search box
                     (query rides SearchManager.QUERY)
                   - SEND text/plain: the share sheet's "search with" path
                     (query rides EXTRA_TEXT)
                   - PROCESS_TEXT: the text-selection floating toolbar
                     (query rides EXTRA_PROCESS_TEXT)
                 All three land in BrowserActivity.handleIntent() and route
                 through loadInTab() — URL-vs-query resolution, engine
                 choice, tracker stripping, the works. -->
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- v1.4.13 — the filter's OWN label: the text-selection toolbar
                 shows the RESOLVED filter's label, not the app name, so this
                 is what turns a bare "Bolt" row into "Search in Bolt" (the
                 documented PROCESS_TEXT shape: action + DEFAULT category +
                 the text/plain MIME, without which the framework's
                 setTypeAndNormalize("text/plain") query never resolves). -->
            <intent-filter android:label="@string/search_in_bolt">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

